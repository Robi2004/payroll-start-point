@startuml
'https://plantuml.com/sequence-diagram

title Payroll Application - Employee API Sequence Diagram

autonumber

actor Client
participant "EmployeeController" as Controller
participant "EmployeeRepository" as Repository
database "H2 Database" as DB

== Get All Employees ==

Client -> Controller: GET /api/v1/employees
activate Controller
Controller -> Repository: findAll()
activate Repository
Repository -> DB: SELECT * FROM employees
activate DB
DB --> Repository: List<Employee>
deactivate DB
Repository --> Controller: List<Employee>
deactivate Repository
Controller --> Client: 200 OK + List<Employee> JSON
deactivate Controller

@enduml